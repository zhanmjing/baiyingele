  "flows": [
    {
      "id": "flow.screenshot-translate",
      "name": "截图翻译",
      "family": "采集 → 转换 → 输出",
      "version": "1.2.0",
      "desc": "截屏 → OCR → 翻译 → 浮层；同一个类，不同语言/开关就是不同实例。",
      "w": 1000,
      "h": 320,
      "params": [
        {
          "key": "sourceLang",
          "label": "源语言",
          "type": "enum",
          "options": [
            "en",
            "ja",
            "zh"
          ],
          "default": "en"
        },
        {
          "key": "targetLang",
          "label": "目标语言",
          "type": "enum",
          "options": [
            "zh",
            "en"
          ],
          "default": "zh"
        },
        {
          "key": "overlay",
          "label": "显示浮层",
          "type": "bool",
          "default": true
        }
      ],
      "nodes": [
        {
          "id": "capture",
          "x": 30,
          "y": 110,
          "w": 150,
          "h": 82,
          "label": "截屏",
          "kind": "point",
          "gate": null,
          "pointClass": "screen.capture",
          "pointInstance": "cap.region",
          "abstract": [
            "region"
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ]
        },
        {
          "id": "ocr",
          "x": 280,
          "y": 110,
          "w": 150,
          "h": 82,
          "label": "OCR",
          "kind": "point",
          "gate": null,
          "pointClass": "ocr.read",
          "pointInstance": "ocr.zh.screen",
          "abstract": [
            "$sourceLang"
          ],
          "inputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ]
        },
        {
          "id": "translate",
          "x": 530,
          "y": 110,
          "w": 150,
          "h": 82,
          "label": "翻译",
          "kind": "point",
          "gate": null,
          "pointClass": "translate.text",
          "pointInstance": "trans.en2zh",
          "abstract": [
            "$sourceLang → $targetLang"
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ]
        },
        {
          "id": "overlay",
          "x": 780,
          "y": 110,
          "w": 150,
          "h": 82,
          "label": "浮层",
          "kind": "point",
          "gate": null,
          "pointClass": "render.overlay",
          "pointInstance": "overlay.toast",
          "abstract": [
            "if $overlay"
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": []
        }
      ],
      "edges": [
        {
          "from": "capture",
          "to": "ocr",
          "label": "Image"
        },
        {
          "from": "ocr",
          "to": "translate",
          "label": "Text"
        },
        {
          "from": "translate",
          "to": "overlay",
          "label": "Text"
        }
      ],
      "code": [
        {
          "text": "flow screenshotTranslate(sourceLang, targetLang, overlay) {",
          "node": null
        },
        {
          "text": "  shot       = screen.capture(region)",
          "node": "capture"
        },
        {
          "text": "  text       = ocr.read(shot, lang = sourceLang)",
          "node": "ocr"
        },
        {
          "text": "  translated = translate.text(text, from = sourceLang, to = targetLang)",
          "node": "translate"
        },
        {
          "text": "  if (overlay) render.overlay(translated)",
          "node": "overlay"
        },
        {
          "text": "}",
          "node": null
        }
      ],
      "instances": [
        {
          "id": "inst.en-zh",
          "name": "英 → 中",
          "rev": 4,
          "args": {
            "sourceLang": "en",
            "targetLang": "zh",
            "overlay": true
          },
          "pins": {
            "capture": "cap.region",
            "ocr": "ocr.zh.screen",
            "translate": "trans.en2zh",
            "overlay": "overlay.toast"
          },
          "trace": {
            "capture": {
              "ms": 120,
              "status": "ok"
            },
            "ocr": {
              "ms": 480,
              "status": "ok"
            },
            "translate": {
              "ms": 760,
              "status": "ok"
            },
            "overlay": {
              "ms": 90,
              "status": "ok"
            }
          }
        },
        {
          "id": "inst.ja-zh",
          "name": "日 → 中",
          "rev": 2,
          "args": {
            "sourceLang": "ja",
            "targetLang": "zh",
            "overlay": false
          },
          "pins": {
            "capture": "cap.region",
            "ocr": "ocr.ja.screen",
            "translate": "trans.ja2zh",
            "overlay": "overlay.toast"
          },
          "trace": {
            "capture": {
              "ms": 115,
              "status": "ok"
            },
            "ocr": {
              "ms": 510,
              "status": "ok"
            },
            "translate": {
              "ms": 820,
              "status": "ok"
            },
            "overlay": {
              "ms": 0,
              "status": "skipped"
            }
          }
        }
      ]
    },
    {
      "id": "flow.invoice-archive",
      "name": "发票归档",
      "family": "批量 / 文件处理",
      "version": "2.0.0",
      "desc": "监听目录 → 遍历文件 → OCR → 提取 → 校验 → 分支移动/通知；规则不同是实例，图相同。",
      "w": 1160,
      "h": 430,
      "params": [
        {
          "key": "watchDir",
          "label": "监考目录",
          "type": "folder",
          "default": "C:\\inbox"
        },
        {
          "key": "vendorRules",
          "label": "供应商规则",
          "type": "enum",
          "options": [
            "company",
            "personal"
          ],
          "default": "company"
        },
        {
          "key": "archiveDir",
          "label": "归档目录",
          "type": "folder",
          "default": "C:\\archive"
        },
        {
          "key": "ocrLang",
          "label": "OCR 语言",
          "type": "enum",
          "options": [
            "zh",
            "en"
          ],
          "default": "zh"
        }
      ],
      "nodes": [
        {
          "id": "watch",
          "x": 20,
          "y": 175,
          "w": 140,
          "h": 82,
          "label": "监听目录",
          "kind": "point",
          "gate": null,
          "pointClass": "file.watch",
          "pointInstance": "watch.inbox",
          "abstract": [
            "$watchDir"
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "files",
              "type": "File[]"
            }
          ]
        },
        {
          "id": "foreach",
          "x": 180,
          "y": 175,
          "w": 120,
          "h": 82,
          "label": "遍历文件",
          "kind": "gate",
          "gate": "foreach",
          "pointClass": null,
          "pointInstance": null,
          "abstract": [
            "file in files"
          ],
          "inputs": [
            {
              "name": "files",
              "type": "File[]"
            }
          ],
          "outputs": [
            {
              "name": "file",
              "type": "File"
            }
          ]
        },
        {
          "id": "ocr",
          "x": 330,
          "y": 175,
          "w": 140,
          "h": 82,
          "label": "OCR",
          "kind": "point",
          "gate": null,
          "pointClass": "ocr.read",
          "pointInstance": "ocr.zh.invoice",
          "abstract": [
            "$ocrLang"
          ],
          "inputs": [
            {
              "name": "file",
              "type": "File"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ]
        },
        {
          "id": "extract",
          "x": 490,
          "y": 175,
          "w": 140,
          "h": 82,
          "label": "提取发票",
          "kind": "point",
          "gate": null,
          "pointClass": "extract.invoice",
          "pointInstance": "extract.vendor",
          "abstract": [
            "$vendorRules"
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "invoice",
              "type": "Invoice"
            }
          ]
        },
        {
          "id": "validate",
          "x": 650,
          "y": 175,
          "w": 140,
          "h": 82,
          "label": "校验",
          "kind": "point",
          "gate": null,
          "pointClass": "validate.invoice",
          "pointInstance": "validate.amount",
          "abstract": [
            "rules = $vendorRules"
          ],
          "inputs": [
            {
              "name": "invoice",
              "type": "Invoice"
            }
          ],
          "outputs": [
            {
              "name": "ok",
              "type": "Bool"
            }
          ]
        },
        {
          "id": "if",
          "x": 810,
          "y": 175,
          "w": 120,
          "h": 82,
          "label": "if 命中",
          "kind": "gate",
          "gate": "if",
          "pointClass": null,
          "pointInstance": null,
          "abstract": [
            "ok?"
          ],
          "inputs": [
            {
              "name": "invoice",
              "type": "Invoice"
            }
          ],
          "outputs": [
            {
              "name": "ok",
              "type": "Bool"
            },
            {
              "name": "else",
              "type": "Bool"
            }
          ]
        },
        {
          "id": "move",
          "x": 960,
          "y": 60,
          "w": 140,
          "h": 82,
          "label": "移动归档",
          "kind": "point",
          "gate": null,
          "pointClass": "file.move",
          "pointInstance": "move.archive",
          "abstract": [
            "to = $archiveDir"
          ],
          "inputs": [
            {
              "name": "file",
              "type": "File"
            }
          ],
          "outputs": []
        },
        {
          "id": "notify",
          "x": 960,
          "y": 290,
          "w": 140,
          "h": 82,
          "label": "未匹配通知",
          "kind": "point",
          "gate": null,
          "pointClass": "notify.tray",
          "pointInstance": "notify.unmatched",
          "abstract": [
            "$(else)"
          ],
          "inputs": [
            {
              "name": "file",
              "type": "File"
            }
          ],
          "outputs": []
        }
      ],
      "edges": [
        {
          "from": "watch",
          "to": "foreach",
          "label": "File[]"
        },
        {
          "from": "foreach",
          "to": "ocr",
          "label": "File"
        },
        {
          "from": "ocr",
          "to": "extract",
          "label": "Text"
        },
        {
          "from": "extract",
          "to": "validate",
          "label": "Invoice"
        },
        {
          "from": "validate",
          "to": "if",
          "label": "Bool"
        },
        {
          "from": "if",
          "to": "move",
          "label": "true",
          "tone": "ok"
        },
        {
          "from": "if",
          "to": "notify",
          "label": "false",
          "tone": "warn"
        }
      ],
      "code": [
        {
          "text": "flow invoiceArchive(watchDir, vendorRules, archiveDir, ocrLang) {",
          "node": null
        },
        {
          "text": "  files = file.watch(watchDir)",
          "node": "watch"
        },
        {
          "text": "  foreach (file in files) {",
          "node": "foreach"
        },
        {
          "text": "    text    = ocr.read(file, lang = ocrLang)",
          "node": "ocr"
        },
        {
          "text": "    invoice = extract.invoice(text, rules = vendorRules)",
          "node": "extract"
        },
        {
          "text": "    ok      = validate.invoice(invoice, rules = vendorRules)",
          "node": "validate"
        },
        {
          "text": "    if (ok) file.move(file, archiveDir)",
          "node": "if"
        },
        {
          "text": "    else    notify.unmatched(file)",
          "node": "notify"
        },
        {
          "text": "  }",
          "node": null
        },
        {
          "text": "}",
          "node": null
        }
      ],
