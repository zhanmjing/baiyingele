    {
      "id": "flow.clipboard-to-file",
      "name": "剪贴板存文件",
      "family": "输入 → 处理 → 保存",
      "version": "1.0.0",
      "desc": "读剪贴板 → 模板 → 写文件 → 通知；路径/追加开关不同就是不同实例。",
      "w": 930,
      "h": 300,
      "params": [
        {
          "key": "path",
          "label": "目标文件",
          "type": "file",
          "default": "~/inbox.md"
        },
        {
          "key": "append",
