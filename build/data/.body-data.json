{
  "classes": [
    {
      "id": "body.file-preview",
      "name": "文件预览",
      "icon": "◈",
      "cat": "content",
      "prio": "P0",
      "desc": "任意文件预览：文本、图片、PDF、视频、音频统一窗口。",
      "flows": [
        "flow.preview-file"
      ],
      "surfaces": [
        "surface.preview-window"
      ],
      "points": [
        "file.read",
        "render.text",
        "render.image"
      ],
      "settings": [
        "preview.maxBytes",
        "preview.encoding",
        "preview.zoom"
      ],
      "perms": [
        "fs.read",
        "window.open"
      ],
      "instances": [
        {
          "label": "text",
          "desc": "文本预览，支持编码/换行识别",
          "rev": 1,
          "acts": [
            ".txt",
            ".log",
            ".json"
          ],
          "settings": "renderer=text · UTF-8",
          "status": "active"
        },
        {
          "label": "markdown",
          "desc": "Markdown 渲染与代码块",
          "rev": 1,
          "acts": [
            ".md",
            ".markdown"
          ],
          "settings": "renderer=markdown · sanitize=true",
          "status": "active"
        },
        {
          "label": "image",
          "desc": "图片预览，fit/zoom",
          "rev": 1,
          "acts": [
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif"
          ],
          "settings": "renderer=image · fit=contain",
          "status": "active"
        },
        {
          "label": "pdf",
          "desc": "PDF 分页/缩放",
          "rev": 1,
          "acts": [
            ".pdf"
          ],
          "settings": "renderer=pdf · page=1 · zoom=fit",
          "status": "active"
        },
        {
          "label": "video",
          "desc": "视频播放器，流式读取",
          "rev": 1,
          "acts": [
            ".mp4",
            ".webm",
            ".mkv"
          ],
          "settings": "renderer=video · stream=true",
          "status": "active"
        },
        {
          "label": "audio",
          "desc": "音频波形与播放",
          "rev": 1,
          "acts": [
            ".mp3",
            ".wav",
            ".flac"
          ],
          "settings": "renderer=audio · waveform=true",
          "status": "active"
        }
      ],
      "tests": [
        "smoke.text",
        "smoke.image",
        "smoke.pdf",
        "contract.renderer"
      ],
      "version": "1.0.0"
    },
