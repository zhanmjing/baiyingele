          "title": "应用检查",
          "body": "$input"
        }
      }
    ],
    "edges": [
      {
        "from": "list",
        "to": "format",
        "label": "WindowInfo[]"
      },
      {
        "from": "format",
        "to": "notify",
        "label": "Text"
      }
    ]
  },
  "flow.ensure-service": {
    "classId": "flow.ensure-service",
    "nodes": [
      {
        "id": "probe",
        "x": 60,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "健康检查",
        "kind": "point",
        "pointClass": "win.http.request",
        "pointInstance": "win.http.request.i-http-github@r1",
