        }
      },
      {
        "id": "notify",
        "x": 440,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "推送结果",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "notify",
        "mapping": {
          "title": "HTTP 提取",
