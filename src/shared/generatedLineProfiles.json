{
  "flow.screenshot-translate": {
    "classId": "flow.screenshot-translate",
    "nodes": [
      {
        "id": "capture",
        "x": 30,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "截屏",
        "kind": "point",
        "pointClass": "screen.capture",
        "pointInstance": "cap.region",
        "role": "region"
      },
      {
        "id": "ocr",
        "x": 280,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "OCR",
        "kind": "point",
        "pointClass": "ocr.read",
        "pointInstance": "ocr.zh.screen",
        "role": "$sourceLang"
      },
      {
        "id": "translate",
        "x": 530,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "翻译",
        "kind": "point",
        "pointClass": "translate.text",
        "pointInstance": "trans.en2zh",
        "role": "$sourceLang → $targetLang"
      },
      {
        "id": "overlay",
        "x": 780,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "浮层",
        "kind": "point",
        "pointClass": "render.overlay",
        "pointInstance": "overlay.toast",
        "role": "if $overlay"
      }
    ],
    "edges": [
      {
        "from": "capture",
        "to": "ocr",
        "label": "Image"
      },
      {
        "from": "ocr",
        "to": "translate",
        "label": "Text"
      },
      {
        "from": "translate",
        "to": "overlay",
        "label": "Text"
      }
    ]
  },
  "flow.invoice-archive": {
