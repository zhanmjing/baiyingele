{
  "flow.screenshot-translate": {
    "classId": "flow.screenshot-translate",
    "nodes": [
      {
        "id": "capture",
        "x": 30,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "截屏",
        "kind": "point",
        "pointClass": "win.screen.capture",
        "pointInstance": "win.screen.capture.i-region@r1",
        "role": "region",
        "rewrittenFrom": "cap.region"
      },
      {
        "id": "ocr",
        "x": 280,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "OCR",
        "kind": "point",
        "pointClass": "win.ocr.read",
        "pointInstance": "win.ocr.read.i-ocr-auto@r1",
        "role": "$sourceLang",
        "rewrittenFrom": "ocr.zh.screen"
      },
      {
        "id": "translate",
        "x": 530,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "翻译",
        "kind": "point",
        "pointClass": "translate.text",
        "pointInstance": "translate.text.i-en2zh@r1",
        "role": "$sourceLang → $targetLang",
        "rewrittenFrom": "trans.en2zh"
      },
      {
        "id": "overlay",
        "x": 780,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "结果通知",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "notify",
        "rewrittenFrom": "overlay.toast"
      }
    ],
    "edges": [
      {
        "from": "capture",
        "to": "ocr",
        "label": "Image"
      },
      {
        "from": "ocr",
        "to": "translate",
        "label": "Text"
      },
      {
        "from": "translate",
        "to": "overlay",
        "label": "Text"
      }
    ]
  },
  "flow.clipboard-to-file": {
    "classId": "flow.clipboard-to-file",
    "nodes": [
      {
        "id": "clip",
        "x": 30,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "读剪贴板",
        "kind": "point",
        "pointClass": "win.clipboard.get",
        "pointInstance": "win.clipboard.get.i-clip-text@r1",
        "role": "format = text",
        "mapping": {}
      },
      {
        "id": "template",
        "x": 250,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "套用模板",
        "kind": "point",
        "pointClass": "text.template",
        "pointInstance": "text.template.i-markdown@r1",
        "role": "template = markdown",
        "mapping": {
          "input": "$input"
        }
      },
      {
        "id": "write",
        "x": 470,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "写文件",
        "kind": "point",
        "pointClass": "file.write",
        "pointInstance": "file.write.i-append@r1",
        "role": "$path, append=$append",
        "mapping": {
          "text": "$input",
          "path": "$args.path",
          "append": "$args.append"
        }
      },
      {
        "id": "notify",
        "x": 690,
        "y": 110,
        "w": 140,
        "h": 82,
        "label": "通知",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "success",
        "mapping": {
          "body": "$input"
        }
      }
    ],
    "edges": [
      {
        "from": "clip",
        "to": "template",
        "label": "Text"
      },
      {
        "from": "template",
        "to": "write",
        "label": "Text"
      },
      {
        "from": "write",
        "to": "notify",
        "label": "done"
      }
    ]
  },
  "flow.open-external-site": {
    "classId": "flow.open-external-site",
    "nodes": [
      {
        "id": "vpn",
        "x": 30,
        "y": 110,
        "w": 160,
        "h": 82,
        "label": "VPN 保障",
        "kind": "subflow",
        "pointClass": "flow.ensure-vpn",
        "pointInstance": "inst.ensure-vpn-ask@r2",
        "role": "vpnRequirement"
      },
      {
        "id": "check",
        "x": 280,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "可达性检查",
        "kind": "point",
        "pointClass": "win.http.request",
        "pointInstance": "win.http.request.i-http-github@r1",
        "role": "host = url.host",
        "rewrittenFrom": "net.reachable.github"
      },
      {
        "id": "open",
        "x": 530,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "打开 URL",
        "kind": "point",
        "pointClass": "win.open",
        "pointInstance": "win.open.i-open-github@r1",
        "role": "url, kind=url",
        "rewrittenFrom": "open.browser.github"
      },
      {
        "id": "notify",
        "x": 780,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "通知",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "success",
        "rewrittenFrom": "notify.system"
      }
    ],
    "edges": [
      {
        "from": "vpn",
        "to": "check",
        "label": "GuardResult"
      },
      {
        "from": "check",
        "to": "open",
        "label": "Bool"
      },
      {
        "from": "open",
        "to": "notify",
        "label": "Bool"
      }
    ]
  },
  "flow.ensure-vpn": {
    "classId": "flow.ensure-vpn",
    "nodes": [
      {
        "id": "probe",
        "x": 60,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "探测网络",
        "kind": "point",
        "pointClass": "win.http.request",
        "pointInstance": "win.http.request.i-http-github@r1",
        "role": "probe",
        "mapping": {
          "url": "$args.url"
        }
      },
      {
        "id": "guard",
        "x": 250,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "可达？",
        "kind": "gate",
        "gate": "if-status",
        "role": "branch"
      },
      {
        "id": "ready",
        "x": 440,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "已就绪提示",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "notify",
        "mapping": {
          "title": "VPN 检查",
          "body": "网络可达，无需打开 VPN"
        }
      },
      {
        "id": "manual",
        "x": 630,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "请手动开启",
        "kind": "point",
        "pointClass": "notify.toast",
        "pointInstance": "notify.toast.i-system@r1",
        "role": "notify",
        "mapping": {
          "title": "VPN 检查",
          "body": "网络不可达，请手动打开 VPN 客户端"
        }
      }
    ],
    "edges": [
      {
        "from": "probe",
        "to": "guard",
        "label": "status"
      },
      {
        "from": "guard",
        "to": "ready",
        "label": "ok"
      },
      {
        "from": "guard",
        "to": "manual",
        "label": "warn"
      }
    ]
  },
  "flow.ensure-app": {
    "classId": "flow.ensure-app",
