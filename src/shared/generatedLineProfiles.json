        }
      }
    ],
    "edges": [
      {
        "from": "fetch",
        "to": "format",
        "label": "Response"
      },
      {
        "from": "format",
        "to": "notify",
        "label": "Text"
      }
    ]
  },
  "flow.ai-rewrite": {
    "classId": "flow.ai-rewrite",
