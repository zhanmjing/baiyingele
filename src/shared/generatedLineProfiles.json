{
  "line.screenshot_translate": {
    "classId": "line.screenshot_translate",
    "nodes": [
      {
        "id": "capture",
        "x": 30,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "截屏",
        "kind": "point",
        "pointClass": "point.screen_capture",
        "pointInstance": "point.screen_capture.region@r1",
        "role": "region",
        "rewrittenFrom": "cap.region"
      },
      {
        "id": "ocr",
        "x": 280,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "OCR",
        "kind": "point",
        "pointClass": "point.ocr_read",
        "pointInstance": "point.ocr_read.auto@r1",
        "role": "$sourceLang",
        "rewrittenFrom": "ocr.zh.screen"
      },
      {
        "id": "translate",
        "x": 530,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "翻译",
        "kind": "point",
        "pointClass": "point.translate_text",
        "pointInstance": "point.translate_text.en2zh@r1",
        "role": "$sourceLang → $targetLang",
        "rewrittenFrom": "trans.en2zh"
      },
      {
        "id": "overlay",
        "x": 780,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "结果通知",
        "kind": "point",
        "pointClass": "point.notify_toast",
        "pointInstance": "point.notify_toast.system@r1",
        "role": "notify",
        "rewrittenFrom": "overlay.toast"
      }
    ],
    "edges": [
      {
        "from": "capture",
        "to": "ocr",
        "label": "Image"
      },
      {
        "from": "ocr",
        "to": "translate",
        "label": "Text"
      },
      {
        "from": "translate",
        "to": "overlay",
        "label": "Text"
      }
    ]
  },
  "line.clipboard_to_file": {
    "classId": "line.clipboard_to_file",
    "nodes": [
      {
        "id": "clip",
        "x": 30,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "读剪贴板",
        "kind": "point",
        "pointClass": "point.clipboard_get",
        "pointInstance": "point.clipboard_get.clip_text@r1",
        "role": "format = text",
        "mapping": {}
      },
      {
        "id": "template",
        "x": 250,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "套用模板",
        "kind": "point",
        "pointClass": "point.text_template",
        "pointInstance": "point.text_template.markdown@r1",
        "role": "template = markdown",
        "mapping": {
          "input": "$input"
        }
      },
      {
        "id": "write",
        "x": 470,
        "y": 110,
        "w": 150,
        "h": 82,
        "label": "写文件",
        "kind": "point",
        "pointClass": "point.file_write",
        "pointInstance": "point.file_write.append@r1",
        "role": "$path, append=$append",
        "mapping": {
          "text": "$input",
          "path": "$args.path",
          "append": "$args.append"
        }
      },
      {
        "id": "notify",
        "x": 690,
        "y": 110,
        "w": 140,
        "h": 82,
        "label": "通知",
        "kind": "point",
        "pointClass": "point.notify_toast",
        "pointInstance": "point.notify_toast.system@r1",
        "role": "success",
        "mapping": {
          "body": "$input"
        }
      }
    ],
    "edges": [
      {
        "from": "clip",
        "to": "template",
        "label": "Text"
      },
      {
        "from": "template",
        "to": "write",
        "label": "Text"
      },
      {
        "from": "write",
        "to": "notify",
        "label": "done"
      }
    ]
  },
