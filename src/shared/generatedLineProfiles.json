    "edges": [
      {
        "from": "approve",
        "to": "guard",
        "label": "status"
      },
      {
        "from": "guard",
        "to": "run",
        "label": "ok"
      },
      {
        "from": "guard",
        "to": "cancel",
        "label": "warn"
      }
    ]
  }
}
