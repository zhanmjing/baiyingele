  "flow.http-extract": {
    "classId": "flow.http-extract",
    "nodes": [
      {
        "id": "fetch",
        "x": 60,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "发送请求",
        "kind": "point",
        "pointClass": "win.http.request",
        "pointInstance": "win.http.request.i-http-github@r1",
        "role": "fetch",
        "mapping": {
          "url": "$args.url",
          "method": "$args.method"
        }
      },
      {
        "id": "format",
        "x": 250,
        "y": 150,
        "w": 160,
        "h": 64,
        "label": "套用模板",
        "kind": "point",
        "pointClass": "text.template",
