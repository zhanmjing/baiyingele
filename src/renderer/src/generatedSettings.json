{
  "sections": [
    {
      "id": "general",
      "group": "General",
      "icon": "⚙",
      "color": "#22d3ee",
      "title": "通用设置",
      "desc": "应用级外观、语言、启动、通知、隐私、网络/更新、可访问性与高级选项。",
      "groups": [
        {
          "label": "Appearance",
          "desc": "全局视觉；Surface 只放布局与交互。",
          "settings": [
            {
              "key": "general.theme",
              "label": "Theme",
              "desc": "应用主题；跟随系统时由 OS 决定。",
              "type": "enum",
              "default": "dark",
              "options": [
                "dark",
                "light",
                "system"
              ],
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "general.accent",
              "label": "Accent color",
              "desc": "强调色；用于选中、焦点与主操作。",
              "type": "enum",
              "default": "cyan",
              "options": [
                "cyan",
                "blue",
                "violet",
                "amber"
              ],
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "general.fontScale",
              "label": "Font scale",
              "desc": "全局字体缩放，100% 为默认。",
              "type": "number",
              "default": 100,
              "min": 80,
              "max": 140,
              "unit": "%",
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "general.density",
              "label": "UI density",
              "desc": "comfortable 更适合阅读，compact 更适合高信息密度。",
              "type": "enum",
              "default": "comfortable",
              "options": [
                "comfortable",
                "compact"
              ],
              "effect": "L0",
              "initialSource": "user"
            }
          ]
        },
        {
          "label": "Language & Region",
          "desc": "应用语言与数字/日期格式。",
          "settings": [
            {
              "key": "general.language",
              "label": "Language",
              "desc": "界面语言，即时生效。",
              "type": "enum",
              "default": "zh-CN",
              "options": [
                "zh-CN",
                "en-US"
              ],
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "general.dateFormat",
              "label": "Date format",
              "desc": "日期显示格式。",
              "type": "enum",
              "default": "YYYY-MM-DD",
              "options": [
                "YYYY-MM-DD",
                "DD/MM/YYYY",
                "MM/DD/YYYY"
              ],
              "effect": "L0"
            },
            {
              "key": "general.numberFormat",
              "label": "Number format",
              "desc": "数字千分位/小数格式。",
              "type": "enum",
              "default": "1,234.56",
              "options": [
                "1,234.56",
                "1.234,56",
                "1 234,56"
              ],
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Startup",
          "desc": "应用启动与工作区恢复。",
          "settings": [
            {
              "key": "general.launchAtLogin",
              "label": "Launch at login",
              "desc": "登录 Windows 后自动启动。",
              "type": "bool",
              "default": false,
              "effect": "L1"
            },
            {
              "key": "general.startMinimized",
              "label": "Start minimized",
              "desc": "启动后进入托盘/最小化。",
              "type": "bool",
              "default": false,
              "effect": "L1"
            },
            {
              "key": "general.restoreLastWorkspace",
              "label": "Restore last workspace",
              "desc": "恢复上次打开的工作区与面板布局。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Notifications",
          "desc": "通知与提示行为。",
          "settings": [
            {
              "key": "general.toastDuration",
              "label": "Toast duration",
              "desc": "轻提示停留时间。",
              "type": "enum",
              "default": "normal",
              "options": [
                "short",
                "normal",
                "long"
              ],
              "effect": "L0"
            },
            {
              "key": "general.doNotDisturb",
              "label": "Do not disturb",
              "desc": "暂停非关键通知。",
              "type": "bool",
              "default": false,
              "effect": "L0"
            },
            {
              "key": "general.sound",
              "label": "Notification sound",
              "desc": "通知是否播放声音。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Privacy & Telemetry",
          "desc": "遥测、崩溃报告与使用数据。",
          "settings": [
            {
              "key": "general.telemetry",
              "label": "Telemetry",
              "desc": "off 完全关闭；basic 只发匿名性能指标。",
              "type": "enum",
              "default": "basic",
              "options": [
                "off",
                "basic",
                "full"
              ],
              "effect": "L1",
              "policy": true
            },
            {
              "key": "general.crashReports",
              "label": "Crash reports",
              "desc": "崩溃时发送诊断包。",
              "type": "bool",
              "default": true,
              "effect": "L1"
            },
            {
              "key": "general.usageData",
              "label": "Usage data",
              "desc": "发送功能使用统计。",
              "type": "bool",
              "default": false,
              "effect": "L1"
            }
          ]
        },
        {
          "label": "Network & Updates",
          "desc": "代理、应用更新通道与检查。",
          "settings": [
            {
              "key": "general.proxy",
              "label": "Proxy",
              "desc": "system 使用系统代理；也可填 http://host:port。",
              "type": "string",
              "default": "system",
              "effect": "L1"
            },
            {
              "key": "general.updateChannel",
              "label": "Update channel",
              "desc": "应用自身更新通道，不是 Body 更新。",
              "type": "enum",
              "default": "stable",
              "options": [
                "stable",
                "beta",
                "dev"
              ],
              "effect": "L1",
              "initialSource": "user"
            },
            {
              "key": "general.autoCheckUpdates",
              "label": "Auto check updates",
              "desc": "启动时检查应用更新。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Accessibility",
          "desc": "对比度、动效与键盘提示。",
          "settings": [
            {
              "key": "general.highContrast",
              "label": "High contrast",
              "desc": "增强边框与文本对比度。",
              "type": "bool",
              "default": false,
              "effect": "L0"
            },
            {
              "key": "general.reduceMotion",
              "label": "Reduce motion",
              "desc": "减少动画；应用设置只能比系统更严格。",
              "type": "bool",
              "default": false,
              "effect": "L0"
            },
            {
              "key": "general.keyboardHints",
              "label": "Keyboard hints",
              "desc": "显示快捷键提示。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Advanced",
          "desc": "开发与实验选项。",
          "settings": [
            {
              "key": "general.developerMode",
              "label": "Developer mode",
              "desc": "显示调试工具与实验入口。",
              "type": "bool",
              "default": false,
              "effect": "L1",
              "advanced": true
            },
            {
              "key": "general.experimentalFeatures",
              "label": "Experimental features",
              "desc": "启用未稳定的功能。",
              "type": "bool",
              "default": false,
              "effect": "L1",
              "advanced": true
            },
            {
              "key": "general.logLevel",
              "label": "Log level",
              "desc": "应用日志级别。",
              "type": "enum",
              "default": "info",
              "options": [
                "info",
                "debug",
                "warn",
                "error"
              ],
              "effect": "L0",
              "advanced": true
            }
          ]
        }
      ]
    },
    {
      "id": "point",
      "group": "Layers",
      "icon": "◆",
      "color": "#22d3ee",
      "title": "点层设置",
      "desc": "点运行时、效果/权限、registry 与 secrets。flow 重试/审批不在这里。",
      "groups": [
        {
          "label": "Runtime",
          "desc": "点执行的默认超时、并发与沙箱。",
          "settings": [
            {
              "key": "point.defaultTimeoutMs",
              "label": "Default timeout",
              "desc": "点执行默认超时；单个 PointInstance 可覆盖。",
              "type": "number",
              "default": 12000,
              "min": 1000,
              "max": 120000,
              "unit": "ms",
              "effect": "L1",
              "initialSource": "user"
            },
            {
              "key": "point.maxConcurrency",
              "label": "Max concurrency",
              "desc": "同时运行的点实例上限。",
              "type": "number",
              "default": 4,
              "min": 1,
              "max": 32,
              "effect": "L1"
            },
            {
              "key": "point.sandbox",
              "label": "Sandbox",
              "desc": "strict 最安全；off 仅开发机。",
              "type": "enum",
              "default": "balanced",
              "options": [
                "strict",
                "balanced",
                "off"
              ],
              "effect": "L2",
              "restart": "app"
            }
          ]
        },
        {
          "label": "Effects & Permissions",
          "desc": "效果等级与权限默认策略。",
          "settings": [
            {
              "key": "point.maxEffect",
              "label": "Max effect",
              "desc": "单点允许的最高效果等级；policy 锁定。",
              "type": "enum",
              "default": "L2",
              "options": [
                "L0",
                "L1",
                "L2",
                "L3"
              ],
              "effect": "L2",
              "policy": true
            },
            {
              "key": "point.requireApprovalForL2",
              "label": "Require approval for L2",
              "desc": "L2 点默认需要审批。",
              "type": "bool",
              "default": true,
              "effect": "L2",
              "policy": true
            },
            {
              "key": "point.logInputs",
              "label": "Log point inputs",
              "desc": "可能含敏感数据；默认关闭。",
              "type": "bool",
              "default": false,
              "effect": "L1",
              "policy": true
            }
          ]
        },
        {
          "label": "Registry & Sources",
          "desc": "点来源、签名与缓存。",
          "settings": [
            {
              "key": "point.registryUrl",
              "label": "Registry URL",
              "desc": "点 registry 地址。",
              "type": "string",
              "default": "https://registry.local",
              "effect": "L1"
            },
            {
              "key": "point.allowUnsignedPoints",
              "label": "Allow unsigned points",
              "desc": "关闭时只加载签名点；开启需要 L3 确认。",
              "type": "bool",
              "default": false,
              "effect": "L3",
              "policy": true
            },
            {
              "key": "point.cacheTtl",
              "label": "Cache TTL",
              "desc": "registry 缓存时间。",
              "type": "number",
              "default": 3600,
              "min": 0,
              "max": 86400,
              "unit": "s",
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Secrets",
          "desc": "凭据存储与显示策略。",
          "settings": [
            {
              "key": "point.secretStore",
              "label": "Secret store",
              "desc": "os/keychain 使用系统凭据库；file 仅开发。",
              "type": "enum",
              "default": "os",
              "options": [
                "os",
                "keychain",
                "file"
              ],
              "effect": "L2"
            },
            {
              "key": "point.revealPolicy",
              "label": "Reveal policy",
              "desc": "never 最安全；once 仅显示一次。",
              "type": "enum",
              "default": "never",
              "options": [
                "never",
                "once",
                "session"
              ],
              "effect": "L2",
              "policy": true
            }
          ]
        }
      ]
    },
    {
      "id": "line",
      "group": "Layers",
      "icon": "↝",
      "color": "#3b82f6",
      "title": "线层设置",
      "desc": "flow 执行、重试/错误策略、审批闸门、trace/retention 与 scheduler。",
      "groups": [
        {
          "label": "Execution",
          "desc": "flow 超时、并发与重试。",
          "settings": [
            {
              "key": "line.defaultTimeoutMs",
              "label": "Default timeout",
              "desc": "flow 默认超时。",
              "type": "number",
              "default": 30000,
              "min": 1000,
              "max": 600000,
              "unit": "ms",
              "effect": "L1"
            },
            {
              "key": "line.maxParallelFlows",
              "label": "Max parallel flows",
              "desc": "同时运行的 flow 上限。",
              "type": "number",
              "default": 3,
              "min": 1,
              "max": 16,
              "effect": "L1"
            },
            {
              "key": "line.retryPolicy",
              "label": "Retry policy",
              "desc": "重试策略；点只声明可重试性，不拥有 retry。",
              "type": "enum",
              "default": "exponential",
              "options": [
                "none",
                "linear",
                "exponential"
              ],
              "effect": "L1"
            },
            {
              "key": "line.maxRetries",
              "label": "Max retries",
              "desc": "最大重试次数。",
              "type": "number",
              "default": 2,
              "min": 0,
              "max": 10,
              "effect": "L1"
            }
          ]
        },
        {
          "label": "Gates & Approvals",
          "desc": "审批闸门与超时。",
          "settings": [
            {
              "key": "line.requireApprovalForL2",
              "label": "Require approval for L2",
              "desc": "L2 flow 默认需要审批。",
              "type": "bool",
              "default": true,
              "effect": "L2",
              "policy": true
            },
            {
              "key": "line.approvalTimeoutS",
              "label": "Approval timeout",
              "desc": "等待审批的秒数。",
              "type": "number",
              "default": 60,
              "min": 5,
              "max": 600,
              "unit": "s",
              "effect": "L1"
            },
            {
              "key": "line.autoDenyOnTimeout",
              "label": "Auto deny on timeout",
              "desc": "超时自动拒绝；安全优先。",
              "type": "bool",
              "default": true,
              "effect": "L2",
              "policy": true
            }
          ]
        },
        {
          "label": "Tracing & Retention",
          "desc": "trace 采样、运行保留与日志级别。",
          "settings": [
            {
              "key": "line.traceSampling",
              "label": "Trace sampling",
              "desc": "采样率越高越占性能/磁盘。",
              "type": "number",
              "default": 10,
              "min": 0,
              "max": 100,
              "unit": "%",
              "effect": "L1"
            },
            {
              "key": "line.runRetentionDays",
              "label": "Run retention",
              "desc": "运行记录保留天数。",
              "type": "number",
              "default": 30,
              "min": 1,
              "max": 365,
              "unit": "days",
              "effect": "L1"
            },
            {
              "key": "line.logLevel",
              "label": "Log level",
              "desc": "flow 日志级别。",
              "type": "enum",
              "default": "info",
              "options": [
                "info",
                "debug",
                "warn",
                "error"
              ],
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Scheduler",
          "desc": "错过的调度与 timezone。",
          "settings": [
            {
              "key": "line.missedRunPolicy",
              "label": "Missed run policy",
              "desc": "错过的定时 flow 如何处理。",
              "type": "enum",
              "default": "skip",
              "options": [
                "skip",
                "runOnce",
                "ask"
              ],
              "effect": "L1"
            },
            {
              "key": "line.timezone",
              "label": "Timezone",
              "desc": "调度时区。",
              "type": "string",
              "default": "Asia/Shanghai",
              "effect": "L0"
            }
          ]
        }
      ]
    },
    {
      "id": "surface",
      "group": "Layers",
      "icon": "▦",
      "color": "#8b5cf6",
      "title": "面层设置",
      "desc": "布局、面板、交互、动效、可访问性与显示格式。只影响呈现/交互。",
      "groups": [
        {
          "label": "Layout & Panels",
          "desc": "面板默认位置、宽度与表格密度。",
          "settings": [
            {
              "key": "surface.defaultPanelSide",
              "label": "Default panel side",
              "desc": "新开面板默认在右/左。",
              "type": "enum",
              "default": "right",
              "options": [
                "right",
                "left"
              ],
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "surface.panelWidth",
              "label": "Default panel width",
              "desc": "默认宽度；PanelInstance 可覆盖，用户调整后 remember。",
              "type": "number",
              "default": 380,
              "min": 300,
              "max": 620,
              "unit": "px",
              "effect": "L0",
              "initialSource": "user"
            },
            {
              "key": "surface.rememberPanelSize",
              "label": "Remember panel size",
              "desc": "记住用户拖拽后的面板尺寸。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            },
            {
              "key": "surface.tableDensity",
              "label": "Table density",
              "desc": "table/tree/list 的默认密度。",
              "type": "enum",
              "default": "comfortable",
              "options": [
                "comfortable",
                "compact"
              ],
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Interaction",
          "desc": "双击、中键与滚轮行为。",
          "settings": [
            {
              "key": "surface.doubleClickAction",
              "label": "Double-click action",
              "desc": "双击列表/卡片时的默认动作。",
              "type": "enum",
              "default": "open",
              "options": [
                "open",
                "run",
                "none"
              ],
              "effect": "L0"
            },
            {
              "key": "surface.middleClickAction",
              "label": "Middle-click action",
              "desc": "中键默认动作。",
              "type": "enum",
              "default": "none",
              "options": [
                "none",
                "open",
                "run"
              ],
              "effect": "L0"
            },
            {
              "key": "surface.wheelBehavior",
              "label": "Wheel behavior",
              "desc": "滚轮滚动或缩放。",
              "type": "enum",
              "default": "scroll",
              "options": [
                "scroll",
                "zoom"
              ],
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Motion",
          "desc": "动效速度；reduce motion 在 General。",
          "settings": [
            {
              "key": "surface.animationSpeed",
              "label": "Animation speed",
              "desc": "slow/normal/fast；受 reduce motion 约束。",
              "type": "enum",
              "default": "normal",
              "options": [
                "slow",
                "normal",
                "fast"
              ],
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Accessibility",
          "desc": "焦点环、读屏提示与焦点归还。",
          "settings": [
            {
              "key": "surface.focusRing",
              "label": "Focus ring",
              "desc": "auto 跟随系统；always 始终显示。",
              "type": "enum",
              "default": "auto",
              "options": [
                "auto",
                "always"
              ],
              "effect": "L0"
            },
            {
              "key": "surface.screenReaderHints",
              "label": "Screen reader hints",
              "desc": "为复杂面板提供额外读屏提示。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            },
            {
              "key": "surface.panelFocusReturn",
              "label": "Return focus on close",
              "desc": "关闭面板后回到触发元素。",
              "type": "bool",
              "default": true,
              "effect": "L0"
            }
          ]
        },
        {
          "label": "Locale & Format",
          "desc": "时间、周起始与度量。",
          "settings": [
            {
              "key": "surface.timeFormat",
              "label": "Time format",
              "desc": "24h 或 12h。",
              "type": "enum",
              "default": "24h",
              "options": [
                "24h",
                "12h"
              ],
              "effect": "L0"
            },
            {
              "key": "surface.firstDayOfWeek",
              "label": "First day of week",
              "desc": "日历周起始。",
              "type": "enum",
              "default": "monday",
              "options": [
                "monday",
                "sunday"
              ],
              "effect": "L0"
            },
            {
              "key": "surface.measurementSystem",
              "label": "Measurement system",
              "desc": "metric/imperial。",
              "type": "enum",
              "default": "metric",
              "options": [
                "metric",
                "imperial"
              ],
              "effect": "L0"
            }
          ]
        }
      ]
    },
    {
      "id": "body",
      "group": "Layers",
      "icon": "▣",
      "color": "#f59e0b",
      "title": "体层设置",
      "desc": "已安装体、更新通道、信任/签名、权限、数据保留与隔离。",
      "groups": [
        {
          "label": "Updates & Channels",
          "desc": "体更新与应用更新分开。",
          "settings": [
            {
              "key": "body.autoUpdate",
              "label": "Auto update bodies",
              "desc": "自动更新已安装体。",
              "type": "bool",
              "default": true,
