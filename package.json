{
  "name": "baiying-electron",
  "version": "0.1.0",
  "description": "百应 · Electron 五层工作台",
  "main": "./out/main/index.js",
  "author": "BaiYing",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "validate": "node scripts/validate-catalog.mjs",
    "validate:strict": "node scripts/validate-catalog.mjs --strict",
    "data:gen": "node scripts/gen-catalogs.mjs --write",
    "data:check": "node scripts/gen-catalogs.mjs",
    "check": "npm run typecheck && npm run validate && npm run build",
    "package": "npm run build && electron-builder --win",
    "dev:raw": "electron-vite dev",
    "start": "node scripts/start.mjs",
    "smoke": "npx tsc src/main/layerStore.ts src/main/flowRuntime.ts --ignoreConfig --outDir .tmp/smoke --module node16 --moduleResolution node16 --target es2022 --skipLibCheck --types node --resolveJsonModule && node scripts/smoke-flow.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.baiying.desktop",
    "productName": "百应",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "百应"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
